<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvCartItemQuantity"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_badge_soft"
        android:text="1x"
        android:textColor="@color/orange_main"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvCartItemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="Bún bò đặc biệt"
        android:textColor="@color/text_dark"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCartItemPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="50.000đ"
        android:textColor="@color/text_dark"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/btnRemoveCartItem"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="@color/red_close"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</LinearLayout>
