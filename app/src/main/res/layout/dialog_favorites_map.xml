<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:strokeColor="#E0D6CC"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Map View -->
        <org.osmdroid.views.MapView
            android:id="@+id/mapFavorites"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Title / Header overlay -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="#E6FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bản đồ Yêu thích 🗺️"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Close Button -->
            <TextView
                android:id="@+id/btnMapClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_saved_remove_btn"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Floating action buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="20dp"
            android:orientation="vertical"
            android:gravity="end">

            <!-- Center to Fit All button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnMapCenterFit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardBackgroundColor="@color/orange_main"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🎯"
                    android:textColor="@color/white"
                    android:textSize="18sp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
