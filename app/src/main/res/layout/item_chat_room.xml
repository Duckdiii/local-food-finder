<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView android:id="@+id/tvRoomName" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tvRoomLastMessage" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tvRoomMembers" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tvRoomTime" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
