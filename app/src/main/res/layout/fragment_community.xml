<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="20dp"
    android:paddingEnd="18dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cộng đồng"
                android:textColor="@color/orange_main"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrentDistrictRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="món ngon Sài Gòn"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCommunitySearch"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_community_input_soft"
            android:gravity="center"
            android:text="🔍"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnCommunityCompose"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_icon_orange"
            android:gravity="center"
            android:text="✎"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnCommunityChatRooms"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_community_chat_cta"
        android:elevation="3dp"
        android:gravity="center"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:text="💬  Chat cộng đồng"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnFeaturedTab"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_community_tab_active"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/tvFeaturedTab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nổi bật"
                    android:textColor="@color/orange_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/tabFeaturedUnderline"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSwitchRoomTab"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_community_tab_inactive"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Mới nhất"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnNearbyRoom"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_community_tab_inactive"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Gần tui"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnNightRoom"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_community_tab_inactive"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Đêm khuya"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvCommunityEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Đang tải bài viết..."
        android:textColor="@color/text_gray"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCommunityPosts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="20dp" />

</LinearLayout>
